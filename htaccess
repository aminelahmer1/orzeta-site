# ============================================================
# Orzeta — protection des fichiers sensibles (OVH / Apache)
# À placer dans le dossier www, à côté de index.php.
# ============================================================

# Empêche quiconque de télécharger le .env et les fichiers techniques
<FilesMatch "^(\.env|\.env\.example|env-pour-ovh\.env|env-local\.env|\.gitignore|\.ovhconfig|diag_env\.php|stockage\.php|.*\.sqlite)$">
    Require all denied
</FilesMatch>

# Bloque l'accès au dossier de la base de données des messages
RedirectMatch 403 ^/data/

# Empêche d'afficher la liste des fichiers d'un dossier
Options -Indexes

# Vitesse : compression des pages et mise en cache dans le navigateur
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 7 days"
    ExpiresByType image/jpeg "access plus 7 days"
    ExpiresByType image/webp "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType image/x-icon "access plus 7 days"
    ExpiresByType video/mp4 "access plus 7 days"
    ExpiresByType text/css "access plus 1 year"
</IfModule>

# Redirection vers l'adresse officielle : https://orzeta.com
RewriteEngine On
RewriteCond %{SERVER_PORT} 80 [OR]
RewriteCond %{HTTP_HOST} ^www\.orzeta\.com$ [NC]
RewriteRule ^(.*)$ https://orzeta.com/$1 [R=301,L]